{
  "name": "apollo-backend",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "",
  "homepage": "https://github.com/ApolloFiles/Apollo#readme",
  "license": "GPL-3.0-or-later",
  "keywords": [],
  "author": {
    "name": "Christian Koop",
    "url": "https://github.com/SpraxDev"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApolloFiles/Apollo.git"
  },
  "bugs": {
    "url": "https://github.com/ApolloFiles/Apollo/issues"
  },
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "postinstall": "npm run prisma:generate || true",

    "build": "tsc",
    "build:podman": "cd .. && podman build --file Containerfile --pull=newer --rm --target ffmpeg-cuda --tag localhost/spraxdev/apollo:latest .",

    "test": "npm run type-check && vitest --run",
    "test:watch": "vitest",
    "test:coverage": "npm run test -- --coverage",
    "test:ci": "npm run test:coverage -- --reporter github-actions",
    "test:acceptance": "vitest --run --project acceptance --reporter=verbose",
    "type-check": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",

    "dev": "node --watch --env-file .env --import @swc-node/register/esm-register --enable-source-maps src/main.ts",

    "prisma:generate": "prisma generate --require-models",
    "prisma:migrate:dev": "prisma migrate dev && npm run prisma:generate",

    "contributors:add": "npx all-contributors add --config ../.all-contributorsrc",
    "contributors:generate": "npx all-contributors generate --config ../.all-contributorsrc"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.73.0",
    "@spraxdev/node-commons": "github:SpraxDev/Node-Commons#651d93d15a2dbd60908668caaf1682c9f089d51a",
    "@types/mime-types": "^3.0.1",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "mime-types": "^3.0.2",
    "openid-client": "^6.8.7",
    "prisma": "^7.10.0",
    "range-parser": "^1.3.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4",
    "tsyringe": "^4.10.0",
    "ws": "^8.21.3",
    "xxhash-addon": "^2.1.0",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@types/range-parser": "^1.2.7",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.1": true,
    "prisma@7.10.0": true,
    "xxhash-addon@2.1.0": true,
    "bufferutil@4.1.0": true
  }
}
